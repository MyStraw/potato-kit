# 데이터 — 절대 커밋하지 않는다
# (data/ 통째 제외가 아니라 내용물 제외 — 그래야 .gitkeep 재포함이 가능하다.
#  gitignore 는 행 끝 주석을 지원하지 않으므로 주석은 반드시 별도 줄에 쓴다)
**/data/*
!**/data/.gitkeep
*.csv
# 예제 결과표는 예제의 일부라 커밋한다
!projects/_example/reports/*.csv
*.xlsx
*.parquet
*.h5
*.nc
*.db
*.sqlite

# 비밀
.env
.env.*
*.key
credentials.json
secrets.*

# 산출물
reports/*.pdf
reports/*.pptx
reports/*.html
submissions/*.csv
*.pkl
*.joblib
models/

# 외부 코드 (논문 재현용 클론)
external/

# 파이썬
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# OS·에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 설계 기록 (후배 전달 시 제외 가능)
_dev/
